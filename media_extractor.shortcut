{
    "actions": [
        {
            "type": "AskForInput",
            "prompt": "Enter API Key",
            "inputType": "Text",
            "name": "API_KEY"
        },
        {
            "type": "GetSharedItems",
            "name": "shared_url"
        },
        {
            "type": "If",
            "condition": "shared_url is empty",
            "actions": [
                {
                    "type": "GetClipboard",
                    "name": "clipboard"
                },
                {
                    "type": "If",
                    "condition": "clipboard contains 'http'",
                    "actions": [
                        {
                            "type": "SetVariable",
                            "name": "shared_url",
                            "value": "clipboard"
                        }
                    ],
                    "otherwise": [
                        {
                            "type": "ShowAlert",
                            "title": "Error",
                            "message": "No valid URL found. Copy a URL to clipboard and try again."
                        }
                    ]
                }
            ]
        },
        {
            "type": "GetContentsOfURL",
            "url": "https://dyk1oekxi0.execute-api.ap-southeast-2.amazonaws.com/prod/get-media",
            "method": "POST",
            "headers": {
                "x-api-key": "API_KEY",
                "Content-Type": "application/json"
            },
            "requestBody": {
                "url": "shared_url"
            },
            "name": "response"
        },
        {
            "type": "GetDictionaryKeys",
            "dictionary": "response",
            "name": "qualities"
        },
        {
            "type": "ChooseFromList",
            "prompt": "Select quality",
            "list": "qualities",
            "name": "selected"
        },
        {
            "type": "GetDictionaryValue",
            "dictionary": "response",
            "key": "selected",
            "name": "video_url"
        },
        {
            "type": "GetContentsOfURL",
            "url": "video_url",
            "method": "GET",
            "name": "video"
        },
        {
            "type": "Share",
            "input": "video"
        }
    ]
}
