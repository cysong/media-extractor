{
    "actions": [
        {
            "type": "SetVariable",
            "name": "shortcut_info",
            "value": {
                "author": "cysong",
                "version": "2",
                "description": "Extracts video download URLs. Supports 1000+ sites. Issues: https://github.com/cysong/media-extractor"
            }
        },
        {
            "type": "AskForInput",
            "prompt": "Enter API Key",
            "inputType": "Text",
            "name": "API_KEY"
        },
        {
            "type": "GetSharedItems",
            "name": "shared_content"
        },
        {
            "type": "If",
            "condition": "shared_content != ''",
            "actions": [
                {
                    "type": "GetVariable",
                    "variable": "shared_content",
                    "name": "shared_url"
                }
            ],
            "otherwise": [
                {
                    "type": "GetClipboard",
                    "name": "clipboard"
                },
                {
                    "type": "If",
                    "condition": "clipboard contains 'http'",
                    "actions": [
                        {
                            "type": "SetVariable",
                            "name": "shared_url",
                            "value": "clipboard"
                        }
                    ],
                    "otherwise": [
                        {
                            "type": "ShowAlert",
                            "title": "Error",
                            "message": "No valid URL found. Make sure a valid link is in your clipboard."
                        }
                    ]
                }
            ]
        },
        {
            "type": "GetContentsOfURL",
            "url": "https://dyk1oekxi0.execute-api.ap-southeast-2.amazonaws.com/prod/get-media",
            "method": "POST",
            "headers": {
                "x-api-key": "API_KEY",
                "Content-Type": "application/json"
            },
            "requestBody": {
                "url": "shared_url"
            },
            "name": "response"
        },
        {
            "type": "If",
            "condition": "response.statusCode != 200",
            "actions": [
                {
                    "type": "ShowAlert",
                    "title": "Error",
                    "message": "Request failed. Status: response.statusCode"
                }
            ]
        },
        {
            "type": "If",
            "condition": "response is not valid",
            "actions": [
                {
                    "type": "ShowAlert",
                    "title": "Error",
                    "message": "Failed to get content. Check if the URL is valid."
                }
            ]
        },
        {
            "type": "GetDictionaryKeys",
            "dictionary": "response",
            "name": "qualities"
        },
        {
            "type": "If",
            "condition": "qualities is empty",
            "actions": [
                {
                    "type": "ShowAlert",
                    "title": "Error",
                    "message": "No resolutions found. Check the video URL."
                }
            ]
        },
        {
            "type": "ChooseFromList",
            "prompt": "Select quality",
            "list": "qualities",
            "name": "selected"
        },
        {
            "type": "GetDictionaryValue",
            "dictionary": "response",
            "key": "selected",
            "name": "video_url"
        },
        {
            "type": "GetContentsOfURL",
            "url": "video_url",
            "method": "GET",
            "name": "video"
        },
        {
            "type": "If",
            "condition": "video is not valid",
            "actions": [
                {
                    "type": "ShowAlert",
                    "title": "Error",
                    "message": "Download failed. Please retry."
                }
            ]
        },
        {
            "type": "Share",
            "input": "video"
        }
    ]
}
